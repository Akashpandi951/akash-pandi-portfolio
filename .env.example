# ==============================================================================
# Portfolio Full-Stack Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# Newly generated Google AI Studio keys use the AQ. format and the Interactions API
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AQ.your_gemini_api_key_here

# Allowed CORS origins (comma-separated if multiple)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Public anon key (Used on frontend admin login & dashboard)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Secret Key (CRITICAL: Server-side only! Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Admin Account Authorization
# Only authenticated users matching this email address can access the admin dashboard
# ------------------------------------------------------------------------------
ADMIN_EMAIL=akashpandi506@gmail.com
ADMIN_NOTIFICATION_EMAIL=akashpandi506@gmail.com

# ------------------------------------------------------------------------------
# Resend Email Configuration (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789abcdefghijklmnopqrstuvwxyz
# Verified sender domain address (or onboarding@resend.dev during testing)
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA (https://dash.cloudflare.com/?to=/:account/turnstile)
# ------------------------------------------------------------------------------
# Client-side Site Key (embedded in public HTML)
CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAx...
# Server-side Secret Key (kept securely on backend)
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx...
