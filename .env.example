# ==============================================================================
# Enterprise Portfolio Backend & MCP Automation System - Environment Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS:
# cp .env.example .env
#
# NOTE: The system features resilient fallbacks. If PostgreSQL or Redis are not
# provided, the server will automatically run with high-performance in-memory
# stores so local development works immediately out of the box!
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# PostgreSQL Database & Prisma ORM
# (Optional in dev: automatically falls back to in-memory repository)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/portfolio_db?schema=public

# ------------------------------------------------------------------------------
# Redis & BullMQ Queue Processing
# (Optional in dev: automatically falls back to resilient in-memory priority queue)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# Security, Authentication & Rate Limiting
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-random-characters-in-production
ADMIN_EMAIL=akashpandi506@gmail.com
ADMIN_DEFAULT_PASSWORD=replace_with_secure_production_password
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# Supabase Cloud Integration (Optional)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (https://aistudio.google.com)
# Powers the portfolio "Ask Akash AI" assistant and Admin AI reply drafts
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AQ.your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Email Notifications via Resend (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=akashpandi506@gmail.com

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Anti-Spam (https://dash.cloudflare.com)
# ------------------------------------------------------------------------------
CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAx...
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx...
